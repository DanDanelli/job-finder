# Copy to .env and adjust. Every variable is optional.

# Data directory (SQLite database, CVs)
JOBFINDER_DATA_DIR=data
# Database URL; when empty, uses sqlite:///<DATA_DIR>/job_finder.db
# JOBFINDER_DATABASE_URL=
JOBFINDER_TIMEZONE=America/Sao_Paulo
JOBFINDER_LOG_LEVEL=INFO
JOBFINDER_HOST=0.0.0.0
JOBFINDER_PORT=8000
# Language of the bot's messages and of what Claude writes: en (default) or pt-BR
# JOBFINDER_LANGUAGE=en

# Claude API (personal key; never commit it)
# ANTHROPIC_API_KEY=sk-ant-...
# Monthly Claude spend cap, in USD (default 5)
# JOBFINDER_MONTHLY_COST_CAP_USD=5

# Telegram (token from @BotFather; never commit it)
# JOBFINDER_TELEGRAM_BOT_TOKEN=123456:ABC...
# Scheduled runs, in JOBFINDER_TIMEZONE
# JOBFINDER_RUN_TIMES=["08:00","18:00"]
# JOBFINDER_DIGEST_MIN_SCORE=60

# JSearch (Google for Jobs; key from app.openwebninja.com). To enable it:
# JOBFINDER_CONNECTORS='["remotive","remoteok","himalayas","jsearch","adzuna"]'
# JOBFINDER_JSEARCH_API_KEY=
# JOBFINDER_JSEARCH_SEARCHES_PER_RUN=3
# JOBFINDER_JSEARCH_MONTHLY_LIMIT=190
# Himalayas: the key is optional
# JOBFINDER_HIMALAYAS_API_KEY=
# JOBFINDER_HIMALAYAS_COUNTRIES='["BR"]'
# JOBFINDER_HIMALAYAS_SEARCHES_PER_RUN=5
# Adzuna: keys from developer.adzuna.com
# JOBFINDER_ADZUNA_APP_ID=
# JOBFINDER_ADZUNA_APP_KEY=
# JOBFINDER_ADZUNA_COUNTRIES='["br"]'
