# Copie para .env e ajuste. Todas as variáveis são opcionais no Marco 0.

# Diretório de dados (banco SQLite, currículos, backups)
JOBFINDER_DATA_DIR=data
# URL do banco; se vazio, usa sqlite:///<DATA_DIR>/job_finder.db
# JOBFINDER_DATABASE_URL=
JOBFINDER_TIMEZONE=America/Sao_Paulo
JOBFINDER_LOG_LEVEL=INFO
JOBFINDER_HOST=0.0.0.0
JOBFINDER_PORT=8000

# Claude API (chave pessoal; nunca commitar)
# ANTHROPIC_API_KEY=sk-ant-...
# Teto mensal de gasto com o Claude, em USD (padrão 5)
# JOBFINDER_CUSTO_MENSAL_MAX_USD=5

# Telegram (token do @BotFather; nunca commitar)
# JOBFINDER_TELEGRAM_BOT_TOKEN=123456:ABC...
# Rodadas agendadas no fuso JOBFINDER_TIMEZONE
# JOBFINDER_HORARIOS=["08:00","18:00"]
# JOBFINDER_DIGEST_SCORE_MINIMO=60

# JSearch (Google for Jobs; chave de app.openwebninja.com). Para ativar:
# JOBFINDER_CONECTORES='["remotive","jsearch"]'
# JOBFINDER_JSEARCH_API_KEY=
# JOBFINDER_JSEARCH_BUSCAS_POR_RODADA=3
# JOBFINDER_JSEARCH_LIMITE_MENSAL=190
